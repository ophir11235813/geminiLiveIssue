# --- Server ---
PORT=4000
NODE_ENV=development
# Origin of the frontend app (for CORS + cookie handling)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the frontend, used in emails
APP_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/springhill_sherpa
# Set to "require" when connecting to a hosted Postgres (Supabase/Neon/Railway/RDS etc).
# Leave as "disable" for a local Postgres without SSL.
PGSSL=disable

# --- Auth ---
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# A shared passphrase that must be entered at signup, proving whoever's
# signing up actually got it from someone in the group. Leave unset to turn
# this gate off entirely (e.g. local dev). Not a substitute for the
# admin-approval step — it's a first filter before an account even reaches
# "pending", not a replacement for it.
SIGNUP_PASSPHRASE=
# Comma-separated list of emails that should always be admins — a safety
# net, not the main way to manage admins day-to-day. It only ever *grants*
# admin (on signup, or on next login for an existing account); it never
# revokes it. Ongoing admin management (promoting/demoting people) happens
# from the Admin page in the app itself, no redeploy needed. If this is left
# empty, the very first person to sign up becomes admin instead, purely as a
# bootstrap for a brand-new deployment.
ADMIN_EMAILS=you@example.com

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset. Override if your account uses a different model id.
CLAUDE_MODEL=claude-sonnet-5

# --- Email (SendGrid) — preferred for OUTBOUND (approval/revoke/reset) ---
# Sends over HTTPS (SendGrid's REST API), not raw SMTP — raw SMTP (below) has
# been unreliable on at least Railway, which appears to throttle/block
# outbound SMTP regardless of destination IP. HTTPS doesn't hit that wall.
# Setup: sign up at sendgrid.com, verify a "Single Sender" (just click the
# confirmation link sent to that inbox — no domain purchase/DNS needed),
# create an API key, set both vars below. Leave unset to fall back to Gmail
# SMTP, then Resend, then console logging.
SENDGRID_API_KEY=
# Must exactly match the address you verified as a Single Sender in SendGrid.
# Defaults to GMAIL_USER if unset, since that's usually the same inbox.
SENDGRID_FROM_EMAIL=

# --- Gmail: email-to-context ingestion, + outbound SMTP fallback ---
# One dedicated Gmail account (NOT your personal one). Ingestion (IMAP) is
# unaffected by the outbound SMTP reliability issue above — it's a separate
# protocol/port and has been fine. Requires 2-Step Verification + an App
# Password on that account (myaccount.google.com/apppasswords) — a regular
# Gmail password won't work for either.
#
# Leave both unset and: ingestion is disabled; outbound falls back further to
# Resend if RESEND_API_KEY is set, otherwise to just logging emails to the
# console. Setting these two turns ingestion on and adds an SMTP fallback.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# How often to check the inbox for forwarded context, in minutes. Defaults to 5.
GMAIL_INGEST_POLL_MINUTES=5

# --- Email (Resend) — last-resort outbound fallback ---
# Leave RESEND_API_KEY unset during local dev; emails will just be logged to the console.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
