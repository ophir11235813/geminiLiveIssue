# --- Server ---
PORT=4000
NODE_ENV=development
# Origin of the frontend app (for CORS + cookie handling)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the frontend, used in emails
APP_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/springhill_sherpa
# Set to "require" when connecting to a hosted Postgres (Supabase/Neon/Railway/RDS etc).
# Leave as "disable" for a local Postgres without SSL.
PGSSL=disable

# --- Auth ---
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of emails that should always be admins — a safety
# net, not the main way to manage admins day-to-day. It only ever *grants*
# admin (on signup, or on next login for an existing account); it never
# revokes it. Ongoing admin management (promoting/demoting people) happens
# from the Admin page in the app itself, no redeploy needed. If this is left
# empty, the very first person to sign up becomes admin instead, purely as a
# bootstrap for a brand-new deployment.
ADMIN_EMAILS=you@example.com

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset. Override if your account uses a different model id.
CLAUDE_MODEL=claude-sonnet-5

# --- Email (Resend) ---
# Leave RESEND_API_KEY unset during local dev; emails will just be logged to the console.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
